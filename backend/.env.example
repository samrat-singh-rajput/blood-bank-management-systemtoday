# ==============================================================================
# BLOOD BANK MANAGEMENT SYSTEM - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `backend/.env` and supply actual values for your deployment.
# NEVER commit your actual `.env` file containing secrets to version control.
# ==============================================================================

# Server Port (default 5000)
PORT=5000

# Environment Mode: 'production' or 'development'
NODE_ENV=production
APP_DEBUG=false

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/bloodbank_system?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/bloodbank_system?retryWrites=true&w=majority
DB_NAME=bloodbank_system

# Google Gemini API Key (Server-side only; never expose to frontend)
# Used for Samrat AI, RAG Embeddings (gemini-embedding-001), and Autonomous MCP Tool Calling
GEMINI_API_KEY=your_gemini_api_key_here
API_KEY=your_gemini_api_key_here

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# AI Rate Limiting & Abuse Prevention
# Maximum AI chat completions permitted per IP per 1-minute sliding window
AI_RATE_LIMIT=30

# External AI Call Timeout (milliseconds)
AI_REQUEST_TIMEOUT=25000

# RAG & MCP Tuning Configuration
RAG_MIN_SCORE=0.80
RAG_DEFAULT_TOP_K=3
MAX_TOOL_ROUNDS=3

# Allowed CORS Origins (comma-separated list of trusted client origins)
# Example: https://my-blood-bank.vercel.app,http://localhost:3000
CORS_ALLOWED_ORIGINS=https://blood-bank-management-system-ecru.vercel.app,http://localhost:3000,http://localhost:5173
